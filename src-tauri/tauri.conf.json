{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quad Squad OC",
  "version": "1.0.0",
  "identifier": "local.quad-squad-oc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quad Squad OC",
        "width": 1500,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../bridge.py": "bridge.py",
      "../native_session.py": "native_session.py",
      "../team.py": "team.py",
      "../squad-plugin.ts": "squad-plugin.ts"
    }
  }
}
